  healthProfile   HealthProfile @relation(fields: [healthProfileId], references: [id], onDelete: Cascade)
  screeningType   String        @map("screening_type")
  score           Int
  interpretation  String
  severity        String?
  completedAt     DateTime      @default(now()) @map("completed_at")
  notes           String?

  @@index([healthProfileId, screeningType])
  @@map("screening_results")
}

model Appointment {
  id              String        @id() @default(cuid())
  healthProfileId String        @map("health_profile_id")
  healthProfile   HealthProfile @relation(fields: [healthProfileId], references: [id], onDelete: Cascade)
  gpId            String        @map("gp_id")
  gpProfile       GPProfile     @relation(fields: [gpId], references: [id])
  date            DateTime      @db.Date()
  timeSlot        String        @map("time_slot")
  durationMinutes Int           @default(15) @map("duration_minutes")
  type            String        @default("IN_PERSON")
  status          String        @default("BOOKED")
  reason          String?       @db.Text()
  notes           String?       @db.Text()
  consultationId  String?       @map("consultation_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt() @map("updated_at")

  @@index([gpId, date])
  @@index([healthProfileId, date])
  @@index([status])
  @@map("appointments")
}

model PathologyOrder {
