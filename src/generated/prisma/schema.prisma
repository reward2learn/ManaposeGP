model Prescription {
  id                String        @id() @default(cuid())
  healthProfileId   String        @map("health_profile_id")
  healthProfile     HealthProfile @relation(fields: [healthProfileId], references: [id], onDelete: Cascade)
  gpId              String        @map("gp_id")
  consultationId    String?       @map("consultation_id")
  medicationName    String        @map("medication_name")
  activeIngredient  String?       @map("active_ingredient")
  strength          String?
  form              String?
  dosage            String
  frequency         String
  route             String?
  quantity          String?
  repeats           Int           @default(0)
  authorityRequired Boolean       @default(false) @map("authority_required")
  authorityNumber   String?       @map("authority_number")
  instructions      String?       @db.Text()
  clinicalNotes     String?       @map("clinical_notes") @db.Text()
  startDate         DateTime      @map("start_date") @db.Date()
  endDate           DateTime?     @map("end_date") @db.Date()
  status            String        @default("ACTIVE")
  dispensedCount    Int           @default(0) @map("dispensed_count")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt() @map("updated_at")

  @@index([healthProfileId, startDate])
  @@index([gpId])
  @@index([status])
  @@index([consultationId])
  @@map("prescriptions")
}

model Invoice {
  id              String        @id() @default(cuid())
  healthProfileId String        @map("health_profile_id")
  healthProfile   HealthProfile @relation(fields: [healthProfileId], references: [id], onDelete: Cascade)
  gpId            String        @map("gp_id")
  consultationId  String?       @map("consultation_id")
  invoiceNumber   String        @unique() @map("invoice_number")
  issueDate       DateTime      @map("issue_date") @db.Date()
  dueDate         DateTime      @map("due_date") @db.Date()
  items           Json          @default("[]")
  subtotalCents   Int           @map("subtotal_cents")
  gstCents        Int           @default(0) @map("gst_cents")
  totalCents      Int           @map("total_cents")
  status          String        @default("ISSUED")
  notes           String?       @db.Text()
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt() @map("updated_at")
  payments        Payment[]

  @@index([healthProfileId, issueDate])
  @@index([gpId, issueDate])
  @@index([status])
  @@index([consultationId])
  @@map("invoices")
}

model Payment {
  id          String   @id() @default(cuid())
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents Int      @map("amount_cents")
  method      String
  reference   String?
  paidAt      DateTime @default(now()) @map("paid_at")
  notes       String?  @db.Text()
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

